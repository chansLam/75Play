<?xml version="1.0" encoding="utf-8"?>
<!-- 弹层（暗）：SURFACE #121A26 @ ~90%，下拉/弹窗需挡实景底图 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#E6121A26" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#9922D3EE" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:endColor="#14FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
