<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#D6E8FF" />
            <stroke android:width="1dp" android:color="#66007AFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#F4F8FF" />
            <stroke android:width="1dp" android:color="#99007AFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#F7F9FC" />
            <stroke android:width="1dp" android:color="#241C1C1E" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
