<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃卡（浅）：深蓝灰冷霜，少白雾；描边偏青，顶高光模拟折射 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#6E5B8FB8"
                android:centerColor="#554A7AA0"
                android:endColor="#403D6688" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="#B30891B2" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:endColor="#28FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
