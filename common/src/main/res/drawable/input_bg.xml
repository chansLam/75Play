<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#E60A1424"
                android:endColor="#CC081018" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#407EB8FF" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#147EB8FF"
                android:centerColor="#00000000"
                android:endColor="#00000000"
                android:centerY="0.3" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
