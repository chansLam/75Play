<?xml version="1.0" encoding="utf-8"?>
<!-- Referenced as android:windowBackground so kits like the i.MX6 head-unit ROM that call
     Resources.getResourceName on the theme background ID never see 0 (a color literal). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/bg_home_photo"
            android:gravity="fill" />
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#22000000"
                android:centerColor="#00000000"
                android:endColor="#33000000"
                android:centerY="0.45" />
        </shape>
    </item>
</layer-list>
