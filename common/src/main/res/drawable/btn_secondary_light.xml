        <shape>
            <gradient
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:endColor="#B8FFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#99FFFFFF" />
