<?xml version="1.0" encoding="utf-8"?>
<!-- 弹层（浅）：冷霜约 92%，挡实景 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#EBF1F5F9" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#B30891B2" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:endColor="#1AFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
