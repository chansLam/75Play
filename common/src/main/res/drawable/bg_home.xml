<?xml version="1.0" encoding="utf-8"?>
<!-- 壳层底（暗）：夜景照片为主，只在顶和底压一点，玻璃才压得住字。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/bg_home_photo"
            android:gravity="fill" />
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#66060A14"
                android:centerColor="#00000000"
                android:endColor="#59060A14"
                android:centerY="0.45" />
        </shape>
    </item>
</layer-list>
